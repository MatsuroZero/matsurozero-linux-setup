# Copy to .env on your deployment host; never commit a real .env file.
PORT=8787
DISCORD_APPLICATION_ID=your_application_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_REDIRECT_URI=https://127.0.0.1
DISCORD_ALLOWED_USER_IDS=your_discord_user_id_1,your_discord_user_id_2\n# Legacy single-user fallback for older deployments:\n# DISCORD_ALLOWED_USER_ID=your_discord_user_id
# Keep the bot token server-side only. Rotate any token previously pasted into chat.
DISCORD_BOT_TOKEN=replace_me
# Reserved for the authenticated local control bridge.
CONTROL_BRIDGE_SECRET=replace_with_a_long_random_secret

# Optional AI providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
# GEMINI_API_KEY=configure_in_your_secret_manager

# Optional: set the same path as the Telegram bot if you overrode its default.
# OLLAMA_MEMORY_PATH=/home/your-user/.local/share/telegram-control-bot/ollama_memory.json

# Optional dashboard links and PIN-protected credential reveal
LINKS_PIN=
SYSTEM_DASHBOARD_URL=http://marwan-pc.local:7171/login
ODYSSEUS_URL=http://marwan-pc.local:7011/
JELLYFIN_URL=http://marwan-pc.local:8096/
UPTIME_KUMA_URL=http://marwan-pc.local:3001/
# Add credentials only if you want them available through the PIN-protected reveal panel.
# SYSTEM_DASHBOARD_USERNAME=
# SYSTEM_DASHBOARD_PASSWORD=
# ODYSSEUS_USERNAME=
# ODYSSEUS_PASSWORD=
# JELLYFIN_USERNAME=
# JELLYFIN_PASSWORD=
# UPTIME_KUMA_USERNAME=
# UPTIME_KUMA_PASSWORD=

# Optional: set if Nexus registry.json is stored somewhere other than its default.
# NEXUS_REGISTRY_PATH=/home/your-user/.config/nexus-control/registry.json

# Optional local health-check endpoints used by Nexus diagnostics
# SYSTEM_DASHBOARD_HEALTH_URL=http://127.0.0.1:7171/
# JELLYFIN_HEALTH_URL=http://127.0.0.1:8096/
# OLLAMA_HEALTH_URL=http://127.0.0.1:11434/api/tags
# UPTIME_KUMA_HEALTH_URL=http://127.0.0.1:3001/
