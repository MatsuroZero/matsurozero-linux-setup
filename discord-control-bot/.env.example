# Copy to .env on your deployment host; never commit a real .env file.
PORT=8787
DISCORD_APPLICATION_ID=your_application_id
DISCORD_CLIENT_SECRET=your_application_client_secret
DISCORD_REDIRECT_URI=https://127.0.0.1
DISCORD_ALLOWED_USER_ID=332036461669122048
# Keep the bot token server-side only. Rotate any token previously pasted into chat.
DISCORD_BOT_TOKEN=replace_me
# Reserved for the authenticated local control bridge.
CONTROL_BRIDGE_SECRET=replace_with_a_long_random_secret

# Optional AI providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
# GEMINI_API_KEY=configure_in_your_secret_manager
